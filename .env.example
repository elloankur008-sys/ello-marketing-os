# ==============================================================================
# Ellocent Marketing OS — Netlify Environment Variables
# Add these inside: Netlify Dashboard -> Site Configuration -> Environment Variables
# ==============================================================================

# --- Phase 2: Supabase Cloud Database, Auth & Realtime ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Phase 3: Composio Real-Time Integration Hub ---
COMPOSIO_API_KEY=your_composio_project_api_key
COMPOSIO_WEBHOOK_SECRET=your_composio_trigger_signing_secret
# Optional Auth Config IDs from Composio Dashboard (comma-separated slug:authConfigId)
COMPOSIO_AUTH_CONFIGS=hubspot:ac_xxx,googlesearchconsole:ac_xxx,googleanalytics:ac_xxx,googleads:ac_xxx,metaads:ac_xxx,slack:ac_xxx

# --- Phase 1/3: Server-Side AI & Diagnostics ---
GEMINI_API_KEY=AIzaSy...
PAGESPEED_API_KEY=AIzaSy...

# --- Webhook Security for Direct Website Lead Forms ---
WEBHOOK_SIGNING_SECRET=replace_with_random_64_char_hex_secret
